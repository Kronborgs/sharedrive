# ───────────────────────────────────────────────
#  PrivateDrive — Environment Configuration
#  Copy this file to .env and fill in the values.
# ───────────────────────────────────────────────

# ── Server ──────────────────────────────────────
# Listen address for the Go HTTP server (inside container, do NOT change unless you know why)
LISTEN_ADDR=:8080

# External URL (used only to construct public share links in emails)
# Example: https://drive.yourdomain.com
BASE_URL=https://drive.example.com

# Comma-separated list of allowed CORS origins (usually matches BASE_URL)
CORS_ORIGINS=https://drive.example.com

# ── PostgreSQL ───────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=privatedrive
POSTGRES_PASSWORD=changeme_strong_password_here
POSTGRES_DB=privatedrive
POSTGRES_SSLMODE=disable

# ── Redis ────────────────────────────────────────
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0

# ── Secrets ──────────────────────────────────────
# All of the following must be set. Generate with: openssl rand -hex 32

# Used to authenticate session tokens
SESSION_SECRET=replace_with_openssl_rand_hex_32

# Used to HMAC-sign backup exports
BACKUP_HMAC_SECRET=replace_with_openssl_rand_hex_32

# Used to AES-256-GCM encrypt TOTP secrets at rest
# Must be exactly 32 bytes (encode as hex → 64 hex chars)
TOTP_ENCRYPT_KEY=replace_with_openssl_rand_hex_32

# Used to HMAC-sign device-trust tokens
DEVICE_TRUST_SECRET=replace_with_openssl_rand_hex_32

# ── Sessions ─────────────────────────────────────
# Session idle timeout (e.g. "24h", "7d")
SESSION_IDLE_TIMEOUT=24h
# Maximum session lifetime regardless of activity
SESSION_ABSOLUTE_TIMEOUT=720h

# ── Rate limiting ────────────────────────────────
# Sliding window: attempts per window per key
RATE_LIMIT_LOGIN_ATTEMPTS=5
RATE_LIMIT_LOGIN_WINDOW=15m
# Progressive lockout after N consecutive failures:
LOCKOUT_TIER1_THRESHOLD=5
LOCKOUT_TIER1_DURATION=60m
LOCKOUT_TIER2_THRESHOLD=10
LOCKOUT_TIER2_DURATION=6h
LOCKOUT_TIER3_THRESHOLD=20
LOCKOUT_TIER3_DURATION=24h

# ── SMTP (optional — can be configured via admin UI later) ───
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=noreply@example.com
SMTP_TLS=true

# ── Storage ──────────────────────────────────────
# Absolute path inside the container where uploaded files are stored.
# This is bind-mounted from the host. See docker-compose.yml volumes.
STORAGE_PATH=/data/files

# ── Cloudflare tunnel ────────────────────────────
# Name of the external Docker network shared with your cloudflared container.
# Must match the network name in your existing cloudflare tunnel compose.
CLOUDFLARE_NETWORK_NAME=cloudflare

# ── Timezone ─────────────────────────────────────
TZ=Europe/Copenhagen

# ── Development ──────────────────────────────────
# Set to "true" in dev to enable verbose logging and disable secure cookie
APP_ENV=production
