# ───────────────────────────────────────────────
#  Sharedrive — Environment Configuration
#  Copy this file to .env and fill in the values.
#  On Unraid, set these directly as container variables.
# ───────────────────────────────────────────────

# ── Server ──────────────────────────────────────
# External URL — used to build share links (e.g. in invite emails)
APP_BASE_URL=https://drive.yourdomain.com

# Comma-separated allowed CORS origins (usually same as APP_BASE_URL)
CORS_ORIGINS=https://drive.yourdomain.com

# ── PostgreSQL ───────────────────────────────────
POSTGRES_HOST=sharedrive-postgres
POSTGRES_PORT=5432
POSTGRES_USER=privatedrive
POSTGRES_PASSWORD=changeme_strong_password_here
POSTGRES_DB=privatedrive
POSTGRES_SSLMODE=disable

# ── Redis ────────────────────────────────────────
REDIS_ADDR=sharedrive-redis:6379

# ── Secrets ──────────────────────────────────────
# All four must be set. Generate each with: openssl rand -hex 32

SESSION_SECRET=replace_with_openssl_rand_hex_32
BACKUP_HMAC_SECRET=replace_with_openssl_rand_hex_32
TOTP_ENCRYPT_KEY=replace_with_openssl_rand_hex_32
DEVICE_TRUST_SECRET=replace_with_openssl_rand_hex_32

# ── SMTP ─────────────────────────────────────────
# Not needed here — configure SMTP in the Setup Wizard (first run)
# or later via Admin → Settings → Email.

# ── Timezone ─────────────────────────────────────
TZ=Europe/Copenhagen
